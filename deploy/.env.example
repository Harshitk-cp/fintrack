# DNS A record for this name must point at the VPS; Caddy fetches the TLS cert.
FINTRACK_DOMAIN=fintrack.example.com
POSTGRES_PASSWORD=
# Generate with: docker compose run --rm app keygen
FINTRACK_DATA_KEY=
# Optional: Claude fallback for unparseable SMS, and the app's Ask tab
ANTHROPIC_API_KEY=
# Push alerts via ntfy (default https://ntfy.sh); "off" disables push
FINTRACK_PUSH_URL=
FINTRACK_PUSH_TOKEN=
