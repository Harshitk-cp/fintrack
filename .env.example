DATABASE_URL=postgres://fintrack:fintrack@127.0.0.1:54329/fintrack
# 32 random bytes, base64. Generate with: pnpm fintrack keygen
# Losing it makes stored raw SMS unreadable (the ledger itself is unaffected).
FINTRACK_DATA_KEY=
FINTRACK_TIME_ZONE=Asia/Kolkata
PORT=8080
# Optional: enables the Claude fallback for SMS the rule-based parser can't read,
# and the app's Ask tab.
ANTHROPIC_API_KEY=
# FINTRACK_LLM_MODEL=claude-haiku-5-5
# Push alerts go through ntfy; users turn them on in the app. Default https://ntfy.sh.
# Set to your own ntfy server to keep alert text off the public one, or "off".
# FINTRACK_PUSH_URL=https://ntfy.sh
# FINTRACK_PUSH_TOKEN=
