{
  "name": "fintrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "fintrack": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts serve",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "bin": {
    "fintrack": "src/main.ts"
  }
}
